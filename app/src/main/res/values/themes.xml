<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShowroomKiosk" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/onGold</item>
